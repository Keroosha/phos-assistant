<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SttTypes.fs" />
    <Compile Include="AudioDecode.fs" />
    <Compile Include="SileroVad.fs" />
    <Compile Include="GigaAm.fs" />
    <Compile Include="Whisper.fs" />
    <Compile Include="SttService.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- sherpa-onnx managed wrapper (1.13.8) pulls the linux-x64 native runtime transitively. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>

</Project>
