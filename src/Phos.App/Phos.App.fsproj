<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="HostedServices.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Phos.Core/Phos.Core.fsproj" />
    <ProjectReference Include="../../src/Phos.Storage/Phos.Storage.fsproj" />
    <ProjectReference Include="../../src/Phos.Telegram/Phos.Telegram.fsproj" />
    <ProjectReference Include="../../src/Phos.Speech/Phos.Speech.fsproj" />
    <ProjectReference Include="../../src/Phos.Omp/Phos.Omp.fsproj" />
    <ProjectReference Include="../../src/Phos.Scheduler/Phos.Scheduler.fsproj" />
  </ItemGroup>

</Project>
