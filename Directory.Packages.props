<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.0.103" />
    <!-- Schedule: pure computation cron expression parsing -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Storage: durable queue / SQLite persistence -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Storage: schema migrations via FluentMigrator runner (SQLite provider uses Microsoft.Data.Sqlite) -->
    <PackageVersion Include="FluentMigrator" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <!-- Logging: ILogger + LoggerMessage.Define (F# has no partial methods, so the [LoggerMessage] source generator is C#-only) -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Telegram: MTProto bot transport -->
    <PackageVersion Include="WTelegramClient" Version="4.4.8" />
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FsUnit.Xunit" Version="6.0.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Spike: LLM (vanbukin OpenAI-compatible) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <!-- Spike: embeddings -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>
</Project>
